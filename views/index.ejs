<!DOCTYPE html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>AZZAM STORE</title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <%- include('partials/header') %>

    <main>
      <section class="hero">
        <div class="hero-copy">
          <p class="eyebrow">اشحن واشتري منتجاتك خلال ثوان</p>
          <h1>أفضل تجربة متجر رقمي عربي</h1>
          <p>اشحن رصيدك بسرعة واشتري ألعاب وبطاقات هدايا وخدمات اشتراك بأمان وسهولة.</p>
          <div class="hero-buttons">
            <a class="hero-card">الألعاب</a>
            <a class="hero-card">بطاقات الهدايا</a>
            <a class="hero-card">الخدمات والاشتراكات</a>
          </div>
        </div>
      </section>

      <section class="popular">
        <div class="section-head"><h2>الأكثر طلباً</h2></div>
        <div class="grid cards-grid">
          <div class="product-card">PUBG</div>
          <div class="product-card">Free Fire</div>
          <div class="product-card">Steam</div>
          <div class="product-card">Roblox</div>
          <div class="product-card">Netflix</div>
          <div class="product-card">Playstation</div>
        </div>
      </section>

      <section class="why-us">
        <div class="section-head"><h2>لماذا نحن</h2></div>
        <div class="grid feature-grid">
          <div class="feature-card"><span>⚡</span><h3>تسليم سريع</h3></div>
          <div class="feature-card"><span>💬</span><h3>دعم مباشر</h3></div>
          <div class="feature-card"><span>🔒</span><h3>دفع آمن</h3></div>
        </div>
      </section>
    </main>

    <a href="https://wa.me/your-number" class="whatsapp-float">واتساب</a>

    <%- include('partials/footer') %>
    <script src="/js/main.js"></script>
  </body>
 </html>
